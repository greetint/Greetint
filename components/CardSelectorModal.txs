'use client';

import React, { useState } from 'react';
import { QRCodeSVG } from 'qrcode.react';

const CARDS = [
  { id: '1', name: 'Signature Luxe', img: '/images/cards/card-1.png' },
  { id: '2', name: 'Playful Celebration', img: '/images/cards/card-2.png' },
  { id: '3', name: 'Chic Pink Stripe', img: '/images/cards/card-3.png' },
  { id: '4', name: 'Modern Blue Stripe', img: '/images/cards/card-4.png' },
];

export default function CardSelectorModal({ cardUrl }: { cardUrl: string }) {
  const [selectedCard, setSelectedCard] = useState(CARDS[0]);

  return (
    <div className="space-y-6 text-center">
      <h3 className="text-xl font-serif text-[#1F1A17] uppercase tracking-wide">
        Избери картичка за принтиране
      </h3>

      <div className="grid grid-cols-2 gap-3">
        {CARDS.map((card) => (
          <button
            key={card.id}
            onClick={() => setSelectedCard(card)}
            className={`p-1 border transition-all ${
              selectedCard.id === card.id ? 'border-[#958679] ring-2 ring-[#958679]/40' : 'border-gray-200 opacity-60'
            }`}
          >
            <img src={card.img} alt={card.name} className="w-full h-auto" />
          </button>
        ))}
      </div>

      {/* ПРЕГЛЕД С ЖИВ QR КОД ВЪРХУ БЯЛОТО ПОЛЕ */}
      <div className="relative inline-block border border-[#958679]/30 shadow-2xl max-w-xs w-full overflow-hidden bg-white">
        <img src={selectedCard.img} alt="Preview" className="w-full h-auto block" />
        
        <div className="absolute bottom-[10%] right-[8%] w-[28%] aspect-square flex items-center justify-center p-1 bg-white rounded-xl">
          <QRCodeSVG value={cardUrl} size={100} className="w-full h-full" />
        </div>
      </div>

      <button
        onClick={() => window.print()}
        className="w-full bg-[#1F1A17] text-[#F7F4EF] py-3.5 text-xs uppercase tracking-[0.2em] font-bold hover:bg-[#958679] transition"
      >
        Принтирай Картичката (PDF) 🖨️
      </button>
    </div>
  );
}